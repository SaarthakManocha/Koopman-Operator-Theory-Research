{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run full pipeline",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/run_all.py",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "Only experiments (bursts already parsed)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/src/run_forecast.py",
      "args": ["data/processed/bursts_trace3.csv"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    }
  ]
}
